* {
  box-sizing: border-box;
}

:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #fff;
  background: #080808;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  background:
    radial-gradient(circle at 50% -10%, rgba(229, 9, 20, 0.18), transparent 35%),
    #080808;
  color: #fff;
}

button,
input,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.app {
  min-height: 100vh;
  background:
    linear-gradient(180deg, rgba(0, 0, 0, 0.05), #080808 70%),
    #080808;
}

.container {
  width: min(1200px, calc(100% - 32px));
  margin: 0 auto;
}

/* HEADER */

.header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(8, 8, 8, 0.88);
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  backdrop-filter: blur(18px);
}

.header-inner {
  min-height: 72px;
  display: flex;
  align-items: center;
  gap: 18px;
}

.logo {
  border: 0;
  background: transparent;
  color: #fff;
  font-size: 25px;
  font-weight: 900;
  letter-spacing: -1.2px;
  padding: 0;
}

.logo span {
  color: #e50914;
}

.back-button,
.admin-access {
  border: 1px solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.05);
  color: #fff;
  border-radius: 10px;
  min-height: 40px;
  padding: 0 14px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  transition: 0.2s ease;
}

.back-button:hover,
.admin-access:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.18);
}

.back-button {
  margin-left: auto;
}

.admin-access {
  font-size: 13px;
  font-weight: 700;
}

/* HERO */

.hero {
  position: relative;
  min-height: 440px;
  display: flex;
  align-items: center;
  overflow: hidden;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 70% 35%, rgba(229, 9, 20, 0.22), transparent 30%),
    linear-gradient(90deg, #080808 15%, rgba(8, 8, 8, 0.75) 50%, rgba(8, 8, 8, 0.2));
  pointer-events: none;
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 700px;
  padding: 70px 0;
}

.hero-content h1 {
  margin: 0;
  font-size: clamp(42px, 7vw, 78px);
  line-height: 0.95;
  letter-spacing: -3px;
  font-weight: 950;
}

.hero-content h1 span {
  color: #e50914;
}

.hero-content p {
  max-width: 620px;
  margin: 22px 0 0;
  color: #b8b8b8;
  font-size: 17px;
  line-height: 1.65;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 18px;
  padding: 7px 12px;
  border-radius: 999px;
  background: rgba(229, 9, 20, 0.12);
  border: 1px solid rgba(229, 9, 20, 0.28);
  color: #ff5a62;
  font-size: 12px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 1px;
}

/* SEARCH */

.search-section {
  padding: 28px 0 8px;
}

.search-box {
  position: relative;
  max-width: 620px;
}

.search-box input {
  width: 100%;
  height: 52px;
  padding: 0 18px 0 48px;
  border-radius: 14px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  outline: none;
  background: #111;
  color: #fff;
  transition: 0.2s ease;
}

.search-box input:focus {
  border-color: rgba(229, 9, 20, 0.65);
  box-shadow: 0 0 0 4px rgba(229, 9, 20, 0.08);
}

.search-box svg {
  position: absolute;
  left: 17px;
  top: 50%;
  transform: translateY(-50%);
  color: #777;
}

/* PRODUCTS */

.products-section {
  padding: 28px 0 70px;
}

.section-title {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 22px;
}

.section-title h2 {
  margin: 0;
  font-size: 25px;
  letter-spacing: -0.7px;
}

.section-title p {
  margin: 5px 0 0;
  color: #777;
  font-size: 14px;
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.product-card {
  position: relative;
  overflow: hidden;
  border-radius: 16px;
  background: #111;
  border: 1px solid rgba(255, 255, 255, 0.07);
  transition:
    transform 0.25s ease,
    border-color 0.25s ease,
    box-shadow 0.25s ease;
}

.product-card:hover {
  transform: translateY(-5px);
  border-color: rgba(229, 9, 20, 0.35);
  box-shadow: 0 18px 45px rgba(0, 0, 0, 0.35);
}

.product-image {
  position: relative;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  background: #151515;
}

.product-image img,
.product-image video {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.product-image img {
  transition: transform 0.4s ease;
}

.product-card:hover .product-image img {
  transform: scale(1.045);
}

.play-overlay {
  position: absolute;
  left: 14px;
  bottom: 14px;
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #e50914;
  color: #fff;
  box-shadow: 0 8px 25px rgba(229, 9, 20, 0.38);
}

.image-placeholder {
  width: 100%;
  height: 100%;
  display: grid;
  place-items: center;
  color: #666;
  background:
    radial-gradient(circle, rgba(229, 9, 20, 0.16), transparent 50%),
    #151515;
}

.product-info {
  padding: 17px;
}

.product-info h3 {
  margin: 0;
  font-size: 16px;
  line-height: 1.35;
}

.product-info p {
  margin: 8px 0 14px;
  color: #888;
  font-size: 13px;
  line-height: 1.5;
}

.product-price {
  color: #fff;
  font-size: 20px;
  font-weight: 900;
}

.product-price span {
  color: #999;
  font-size: 12px;
  font-weight: 500;
}

.product-button {
  width: 100%;
  min-height: 44px;
  margin-top: 14px;
  border: 0;
  border-radius: 10px;
  background: #e50914;
  color: #fff;
  font-weight: 800;
  transition: 0.2s ease;
}

.product-button:hover {
  background: #ff1723;
  transform: translateY(-1px);
}

/* PRODUCT PAGE */

.product-page {
  padding-top: 32px;
  padding-bottom: 80px;
}

.product-video {
  width: 100%;
  max-width: 1050px;
  margin: 0 auto 30px;
  overflow: hidden;
  border-radius: 16px;
  background: #000;
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 25px 70px rgba(0, 0, 0, 0.45);
}

.product-video video {
  width: 100%;
  display: block;
}

.video-placeholder {
  min-height: 420px;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 12px;
  color: #777;
}

.product-details {
  max-width: 900px;
  margin: 0 auto;
}

.product-details h1 {
  margin: 0;
  font-size: clamp(28px, 5vw, 44px);
  letter-spacing: -1.5px;
}

.product-details p {
  color: #aaa;
  line-height: 1.7;
}

.product-details .price {
  margin: 20px 0;
  font-size: 30px;
  font-weight: 900;
}

/* EMPTY / LOADING */

.loading,
.empty-state {
  min-height: 300px;
  display: grid;
  place-items: center;
  text-align: center;
  color: #888;
}

.empty-state h3 {
  margin: 0 0 8px;
  color: #fff;
  font-size: 20px;
}

.empty-state p {
  margin: 0;
}

/* FOOTER */

.footer {
  margin-top: auto;
  padding: 45px 0;
  border-top: 1px solid rgba(255, 255, 255, 0.07);
  color: #777;
  text-align: center;
  font-size: 13px;
}

/* RESPONSIVE */

@media (max-width: 1000px) {
  .products-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .container {
    width: min(100% - 22px, 1200px);
  }

  .header-inner {
    min-height: 62px;
  }

  .hero {
    min-height: 390px;
  }

  .hero-content {
    padding: 55px 0;
  }

  .hero-content h1 {
    font-size: 48px;
    letter-spacing: -2px;
  }

  .hero-content p {
    font-size: 15px;
  }

  .products-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 11px;
  }

  .product-info {
    padding: 13px;
  }

  .product-info h3 {
    font-size: 14px;
  }

  .product-price {
    font-size: 17px;
  }

  .product-button {
    min-height: 42px;
    font-size: 13px;
  }

  .admin-access {
    padding: 0 10px;
  }

  .back-button {
    padding: 0 10px;
  }
}

@media (max-width: 430px) {
  .products-grid {
    grid-template-columns: 1fr;
  }

  .hero-content h1 {
    font-size: 42px;
  }

  .admin-access {
    font-size: 0;
  }

  .admin-access svg {
    margin: 0;
  }
}
